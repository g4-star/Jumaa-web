@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap");

:root {
  --bg: #07110e;
  --bg2: #0b1713;
  --panel: #101f1a;
  --green: #29d391;
  --green2: #13a96d;
  --cream: #f3f7f4;
  --muted: #9baaa3;
  --line: rgba(255,255,255,.1);
  --white: #fff;
  font-family: "DM Sans", sans-serif;
  color: var(--cream);
  background: var(--bg);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
  margin: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-width: 320px;
  background:
    radial-gradient(circle at 80% 5%, rgba(41,211,145,.09), transparent 30rem),
    radial-gradient(circle at 10% 45%, rgba(19,169,109,.06), transparent 28rem),
    var(--bg);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
select {
  font: inherit;
}

.site {
  overflow: hidden;
  min-height: 100vh;
}

.navbar {
  width: min(1180px, calc(100% - 40px));
  height: 78px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 20;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font: 800 20px Manrope, sans-serif;
  letter-spacing: -.6px;
}

.brand-mark {
  width: 36px;
  height: 36px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: var(--green);
  color: #06251a;
  box-shadow: 0 8px 25px rgba(41,211,145,.2);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 30px;
  color: #b5c1bc;
  font-size: 14px;
}

.nav-links a:not(.nav-download):hover {
  color: var(--green);
}

.nav-download,
.primary-button,
.search-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border-radius: 12px;
  background: var(--green);
  color: #06251a;
  font-weight: 800;
  padding: 12px 18px;
  transition: .25s ease;
}

.nav-download:hover,
.primary-button:hover,
.search-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 30px rgba(41,211,145,.18);
}

.menu-button {
  display: none;
  border: 0;
  color: white;
  background: transparent;
}

.hero {
  width: min(1180px, calc(100% - 40px));
  min-height: 690px;
  margin: auto;
  display: grid;
  grid-template-columns: .92fr 1.08fr;
  align-items: center;
  gap: 55px;
  position: relative;
}

.hero-content {
  position: relative;
  z-index: 3;
}

.eyebrow,
.section-label {
  color: var(--green);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  border: 1px solid rgba(41,211,145,.2);
  background: rgba(41,211,145,.06);
  padding: 9px 13px;
  border-radius: 30px;
  margin-bottom: 25px;
}

.pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 0 5px rgba(41,211,145,.1);
}

.hero h1,
.section h2,
.how-content h2,
.download-copy h2,
.owners-content h2,
.section-center h2,
.contact-section h2 {
  font-family: Manrope, sans-serif;
  font-weight: 800;
  letter-spacing: -2.8px;
  line-height: .98;
}

.hero h1 {
  font-size: clamp(48px, 5.8vw, 78px);
  max-width: 650px;
}

.hero h1 span {
  display: block;
  color: var(--green);
}

.hero p {
  color: var(--muted);
  font-size: 17px;
  line-height: 1.7;
  max-width: 560px;
  margin: 26px 0 30px;
}

.hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.secondary-button,
.outline-button {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 12px 18px;
  border: 1px solid var(--line);
  border-radius: 12px;
  color: white;
  background: rgba(255,255,255,.035);
  font-weight: 700;
}

.secondary-button:hover,
.outline-button:hover {
  border-color: rgba(41,211,145,.4);
  background: rgba(41,211,145,.06);
}

.hero-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 32px;
  color: #84938c;
  font-size: 12px;
}

.hero-trust div {
  display: flex;
  align-items: center;
  gap: 7px;
}

.hero-trust svg {
  color: var(--green);
}

.hero-visual {
  position: relative;
}

.hero-image-frame {
  height: 560px;
  border-radius: 32px;
  overflow: hidden;
  position: relative;
  border: 1px solid rgba(255,255,255,.1);
  box-shadow: 0 35px 90px rgba(0,0,0,.45);
  transform: rotate(1deg);
}

.hero-image-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 35%, rgba(3,12,9,.8));
}

.floating-card {
  position: absolute;
  background: rgba(11,24,19,.9);
  backdrop-filter: blur(18px);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 15px;
  box-shadow: 0 20px 50px rgba(0,0,0,.3);
}

.property-card {
  bottom: 28px;
  left: 25px;
  right: 25px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
}

.property-card strong,
.property-card span {
  display: block;
}

.property-card strong {
  font-size: 13px;
}

.property-card span {
  color: #89968f;
  font-size: 11px;
  margin-top: 3px;
}

.mini-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: rgba(41,211,145,.12);
  color: var(--green);
}

.verified {
  margin-left: auto;
  color: var(--green);
}

.price-card {
  right: -18px;
  top: 60px;
  padding: 15px 18px;
}

.price-card span,
.price-card small {
  display: block;
  color: #88968f;
  font-size: 10px;
}

.price-card strong {
  display: block;
  color: var(--green);
  font: 800 19px Manrope;
  margin: 4px 0;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(70px);
  pointer-events: none;
}

.glow-one {
  width: 300px;
  height: 300px;
  background: rgba(41,211,145,.1);
  left: -180px;
  top: 100px;
}

.glow-two {
  width: 280px;
  height: 280px;
  background: rgba(41,211,145,.08);
  right: -150px;
  bottom: 30px;
}

.search-section {
  width: min(1080px, calc(100% - 40px));
  margin: -20px auto 0;
  position: relative;
  z-index: 5;
}

.search-heading {
  margin-bottom: 13px;
}

.search-heading span {
  color: var(--green);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

.search-heading h2 {
  margin-top: 5px;
  font: 700 22px Manrope;
}

.search-box {
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  gap: 10px;
  padding: 10px;
  border: 1px solid var(--line);
  background: rgba(16,31,26,.9);
  backdrop-filter: blur(20px);
  border-radius: 17px;
  box-shadow: 0 25px 70px rgba(0,0,0,.25);
}

.field {
  min-height: 62px;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 14px;
  border-radius: 11px;
  background: rgba(255,255,255,.035);
  color: var(--green);
}

.field div {
  flex: 1;
}

.field label {
  display: block;
  color: #76857e;
  font-size: 10px;
  margin-bottom: 3px;
}

.field select {
  width: 100%;
  border: 0;
  outline: 0;
  appearance: none;
  background: transparent;
  color: white;
  font-size: 13px;
}

.field option {
  color: #111;
}

.search-button {
  min-width: 160px;
}

.stats {
  width: min(1000px, calc(100% - 40px));
  margin: 70px auto 0;
  padding: 28px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.stats div {
  text-align: center;
  border-right: 1px solid var(--line);
}

.stats div:last-child {
  border: 0;
}

.stats strong {
  display: block;
  color: var(--green);
  font: 800 22px Manrope;
}

.stats span {
  display: block;
  margin-top: 5px;
  color: #7f8c86;
  font-size: 12px;
}

.section {
  width: min(1180px, calc(100% - 40px));
  margin: auto;
  padding: 130px 0;
}

.section-top {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 50px;
  margin-bottom: 45px;
}

.section h2,
.how-content h2,
.download-copy h2,
.owners-content h2,
.section-center h2,
.contact-section h2 {
  font-size: clamp(40px, 5vw, 61px);
  margin-top: 12px;
}

em {
  color: var(--green);
  font-style: normal;
}

.section-top p,
.how-content > p,
.download-copy > p,
.owners-content > p,
.contact-section p {
  max-width: 430px;
  color: var(--muted);
  line-height: 1.7;
}

.apartment-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.apartment-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 22px;
  overflow: hidden;
  transition: .3s ease;
}

.apartment-card:hover {
  transform: translateY(-7px);
  border-color: rgba(41,211,145,.28);
}

.apartment-image {
  height: 300px;
  position: relative;
  overflow: hidden;
}

.apartment-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: .5s ease;
}

.apartment-card:hover .apartment-image img {
  transform: scale(1.05);
}

.image-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,.18), transparent 45%, rgba(0,0,0,.7));
}

.verified-badge,
.location-badge {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  font-weight: 700;
}

.verified-badge {
  left: 13px;
  top: 13px;
  padding: 7px 9px;
  border-radius: 20px;
  color: #072519;
  background: var(--green);
}

.heart-button {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 34px;
  height: 34px;
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 50%;
  background: rgba(0,0,0,.35);
  color: white;
  font-size: 19px;
}

.location-badge {
  left: 14px;
  bottom: 13px;
  color: white;
}

.apartment-info {
  padding: 19px;
}

.apartment-info h3 {
  font: 700 19px Manrope;
}

.apartment-bottom {
  display: flex;
  align-items: end;
  justify-content: space-between;
  margin-top: 19px;
}

.apartment-bottom small {
  color: #738078;
  font-size: 10px;
}

.apartment-bottom strong {
  color: var(--green);
  font: 800 16px Manrope;
  margin-left: 4px;
}

.apartment-bottom a {
  display: flex;
  align-items: center;
  gap: 5px;
  color: white;
  font-size: 12px;
  font-weight: 700;
}

.how-section,
.download-section,
.owners-section,
.contact-section {
  width: min(1180px, calc(100% - 40px));
  margin: auto;
  border-radius: 30px;
}

.how-section {
  padding: 30px;
  display: grid;
  grid-template-columns: .95fr 1.05fr;
  gap: 70px;
  align-items: center;
  background: linear-gradient(135deg, #0d2019, #091510);
  border: 1px solid var(--line);
}

.how-image {
  height: 600px;
  border-radius: 23px;
  overflow: hidden;
  position: relative;
}

.how-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.how-image::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(transparent 40%, rgba(2,12,8,.8));
}

.how-image-label {
  position: absolute;
  z-index: 2;
  left: 20px;
  bottom: 20px;
  display: flex;
  align-items: center;
  gap: 9px;
  color: white;
  font-size: 12px;
}

.how-content > p {
  margin: 25px 0 35px;
}

.steps {
  border-top: 1px solid var(--line);
}

.step {
  display: grid;
  grid-template-columns: 45px 1fr;
  gap: 15px;
  padding: 23px 0;
  border-bottom: 1px solid var(--line);
}

.step > span {
  color: var(--green);
  font: 700 12px Manrope;
}

.step h3 {
  font: 700 17px Manrope;
}

.step p {
  color: #7f8c86;
  font-size: 13px;
  line-height: 1.6;
  margin-top: 5px;
}

.download-section {
  margin-top: 120px;
  padding: 75px;
  min-height: 600px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  background:
    radial-gradient(circle at 75% 50%, rgba(41,211,145,.12), transparent 30%),
    #0b1914;
  border: 1px solid var(--line);
  position: relative;
}

.download-copy > p {
  margin: 24px 0;
}

.feature-list {
  display: grid;
  gap: 11px;
  margin-bottom: 30px;
  color: #b3c0ba;
  font-size: 13px;
}

.feature-list div {
  display: flex;
  align-items: center;
  gap: 8px;
}

.feature-list svg {
  width: 17px;
  color: var(--green);
}

.phone-showcase {
  height: 500px;
  display: grid;
  place-items: center;
  position: relative;
}

.phone-glow {
  position: absolute;
  width: 330px;
  height: 330px;
  border-radius: 50%;
  background: rgba(41,211,145,.12);
  filter: blur(60px);
}

.phone {
  width: 245px;
  height: 475px;
  padding: 9px;
  border-radius: 38px;
  background: #020605;
  border: 2px solid #35443e;
  box-shadow: 0 40px 80px rgba(0,0,0,.5);
  position: relative;
  z-index: 2;
  transform: rotate(5deg);
}

.phone-notch {
  position: absolute;
  z-index: 5;
  width: 90px;
  height: 23px;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 20px;
  background: #020605;
}

.phone-screen {
  height: 100%;
  border-radius: 30px;
  overflow: hidden;
  background: #f1f5f2;
  color: #14251f;
  padding: 25px 14px;
}

.phone-top {
  display: flex;
  justify-content: space-between;
  color: #0b3d2e;
  font: 800 12px Manrope;
  padding-top: 5px;
}

.phone-screen h4 {
  font: 800 28px Manrope;
  line-height: 1;
  margin: 28px 4px 15px;
}

.phone-screen h4 span {
  color: #0e9d68;
}

.phone-search {
  display: flex;
  gap: 7px;
  align-items: center;
  background: white;
  border: 1px solid #e2e9e5;
  border-radius: 9px;
  padding: 9px;
  color: #87928d;
  font-size: 9px;
}

.phone-screen > img {
  width: 100%;
  height: 160px;
  object-fit: cover;
  border-radius: 13px;
  margin-top: 12px;
}

.phone-property {
  padding: 9px 2px;
}

.phone-property strong,
.phone-property span {
  display: block;
}

.phone-property strong {
  font: 700 12px Manrope;
}

.phone-property span {
  color: #7b8882;
  font-size: 9px;
  margin-top: 4px;
}

.owners-section {
  margin-top: 120px;
  padding: 80px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
  background:
    linear-gradient(115deg, rgba(41,211,145,.1), transparent 45%),
    #0b1713;
  border: 1px solid var(--line);
}

.owners-content > p {
  margin: 25px 0;
}

.owner-features {
  display: grid;
  gap: 12px;
  margin: 25px 0 32px;
  color: #a9b6b0;
  font-size: 13px;
}

.owner-features div {
  display: flex;
  align-items: center;
  gap: 10px;
}

.owner-features svg {
  width: 18px;
  color: var(--green);
}

.owner-panel {
  padding: 22px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 20px;
  background: rgba(255,255,255,.035);
  box-shadow: 0 30px 70px rgba(0,0,0,.25);
}

.panel-top,
.panel-property,
.panel-row {
  display: flex;
  align-items: center;
}

.panel-top {
  justify-content: space-between;
  font-size: 9px;
  letter-spacing: 1.5px;
  color: #7f8e87;
}

.live {
  color: var(--green);
}

.live i {
  display: inline-block;
  width: 6px;
  height: 6px;
  background: var(--green);
  border-radius: 50%;
  margin-right: 5px;
}

.panel-property {
  gap: 12px;
  margin: 25px 0;
}

.panel-property img {
  width: 55px;
  height: 55px;
  border-radius: 10px;
  object-fit: cover;
}

.panel-property strong,
.panel-property span {
  display: block;
}

.panel-property strong {
  font: 700 14px Manrope;
}

.panel-property span {
  color: #77857e;
  font-size: 10px;
  margin-top: 4px;
}

.panel-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 17px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.panel-stats div {
  text-align: center;
  border-right: 1px solid var(--line);
}

.panel-stats div:last-child {
  border: 0;
}

.panel-stats strong,
.panel-stats span {
  display: block;
}

.panel-stats strong {
  font: 800 20px Manrope;
}

.panel-stats span {
  color: #75837c;
  font-size: 9px;
  margin-top: 3px;
}

.panel-line {
  height: 7px;
  border-radius: 10px;
  background: linear-gradient(90deg, var(--green) 65%, #1c3128 65%);
  margin: 23px 0;
}

.panel-row {
  justify-content: space-between;
  padding: 8px 0;
  color: #829089;
  font-size: 10px;
}

.panel-row b {
  color: var(--green);
  font-weight: 700;
}

.why-section {
  width: min(1180px, calc(100% - 40px));
  margin: auto;
  padding: 140px 0;
}

.section-center {
  text-align: center;
}

.why-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 50px;
}

.why-card {
  min-height: 260px;
  padding: 30px;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: rgba(255,255,255,.025);
  position: relative;
}

.why-card.featured {
  background: linear-gradient(145deg, rgba(41,211,145,.13), rgba(255,255,255,.025));
  border-color: rgba(41,211,145,.18);
}

.why-card > svg {
  color: var(--green);
  width: 25px;
}

.why-card > span {
  position: absolute;
  right: 25px;
  top: 28px;
  color: #56645e;
  font-size: 11px;
}

.why-card h3 {
  font: 700 20px Manrope;
  margin-top: 40px;
}

.why-card p {
  color: #788780;
  line-height: 1.7;
  font-size: 13px;
  margin-top: 10px;
}

.contact-section {
  padding: 75px;
  display: grid;
  grid-template-columns: 1fr .9fr;
  gap: 80px;
  align-items: center;
  background:
    radial-gradient(circle at 20% 50%, rgba(41,211,145,.12), transparent 35%),
    #0b1914;
  border: 1px solid var(--line);
}

.contact-section p {
  margin-top: 25px;
}

.contact-actions {
  display: grid;
  gap: 10px;
}

.contact-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 17px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(255,255,255,.035);
}

.contact-card:hover {
  border-color: rgba(41,211,145,.3);
  transform: translateX(4px);
}

.contact-card > span {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: rgba(41,211,145,.1);
  color: var(--green);
}

.contact-card div {
  flex: 1;
}

.contact-card small,
.contact-card strong {
  display: block;
}

.contact-card small {
  color: #75837c;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.contact-card strong {
  font-size: 13px;
  margin-top: 4px;
}

.contact-card > svg {
